#!/usr/bin/env bash

fail() {
    echo "pbcopy: usable clipboard backend was not found" >&2
    exit 1
}

is_wsl() {
    if [ -f /proc/sys/fs/binfmt_misc/WSLInterop ]; then
        return 0
    fi

    if [ -r /proc/version ]; then
        if grep -i microsoft /proc/version >/dev/null 2>&1; then
            return 0
        fi
    fi

    return 1
}

copy_with_powershell() {
    # PowerShell must expand these variables; the shell must preserve them literally.
    # shellcheck disable=SC2016
    powershell_command='[Console]::InputEncoding = [System.Text.Encoding]::UTF8; $text = [Console]::In.ReadToEnd(); Set-Clipboard -Value $text'

    if command -v powershell.exe >/dev/null 2>&1; then
        powershell.exe -NoLogo -NoProfile -NonInteractive -Command "${powershell_command}"
        return $?
    fi

    powershell_path='/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe'
    if [ -x "${powershell_path}" ]; then
        "${powershell_path}" -NoLogo -NoProfile -NonInteractive -Command "${powershell_command}"
        return $?
    fi

    return 1
}

copy_on_wsl() {
    if command -v win32yank.exe >/dev/null 2>&1; then
        win32yank.exe -i --crlf
        return $?
    fi

    if command -v powershell.exe >/dev/null 2>&1; then
        copy_with_powershell
        return $?
    fi

    if [ -x /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe ]; then
        copy_with_powershell
        return $?
    fi

    # Last resort for systems without PowerShell. Non-ASCII text can depend on
    # the active Windows code page, so this backend is intentionally last.
    if command -v clip.exe >/dev/null 2>&1; then
        clip.exe
        return $?
    fi

    if [ -x /mnt/c/Windows/System32/clip.exe ]; then
        /mnt/c/Windows/System32/clip.exe
        return $?
    fi

    return 1
}

copy_on_linux() {
    if [ -n "${WAYLAND_DISPLAY}" ]; then
        if command -v wl-copy >/dev/null 2>&1; then
            wl-copy
            return $?
        fi
    fi

    if [ -n "${DISPLAY}" ]; then
        if command -v xsel >/dev/null 2>&1; then
            xsel --clipboard --input
            return $?
        fi
    fi

    return 1
}

main() {
    operating_system=$(uname -s)

    if [ -n "${TMUX}" ] && { [ -n "${SSH_CONNECTION}" ] || [ -n "${SSH_CLIENT}" ]; }; then
        if ! command -v tmux >/dev/null 2>&1; then
            fail
        fi
        tmux load-buffer -w -
        exit $?
    fi

    if [ "${operating_system}" = "Darwin" ]; then
        /usr/bin/pbcopy
        exit $?
    fi

    if is_wsl; then
        copy_on_wsl
        status=$?
        if [ "${status}" -eq 0 ]; then
            exit 0
        fi
        fail
    fi

    copy_on_linux
    status=$?
    if [ "${status}" -eq 0 ]; then
        exit 0
    fi

    fail
}

main
